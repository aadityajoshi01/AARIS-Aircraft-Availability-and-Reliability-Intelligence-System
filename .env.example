# AARIS security configuration — copy to `.env` (git-ignored) and set real
# values, or export these as environment variables before starting the services.

# JWT signing key for the ground station (REQUIRED in any real deployment;
# without it the ground station prints a warning and uses an insecure default).
AEROGUARD_SECRET_KEY=change-me

# Static bearer token for the AC-017 edge device (maps to aircraft AC-017).
# The demo default is "edge-ac017-dev-token"; change it for anything real.
EDGE_AC017_TOKEN=change-me

# One token slot per aircraft, named EDGE_<AIRCRAFT>_TOKEN. The ground station
# registers a device for EVERY entry in ground/fleet_config.json (AC-001..AC-090),
# so the whole-fleet live feed (edge/live_reporter.py --fleet) works on localhost
# with no extra config — each aircraft just uses its own deterministic
# edge-ac###-dev-token default. Set one real value per physical device and export
# it on both sides; a device token can only report for its own aircraft (else 403).
# While any slot is unset the ground logs a startup warning that guessable demo
# tokens are in use (it never prints a token).
# EDGE_AC002_TOKEN=change-me
# EDGE_AC003_TOKEN=change-me

# Optional: access-token lifetime in minutes (default 60).
# AEROGUARD_JWT_TTL_MIN=60

# Optional: ground station bind. Default 127.0.0.1 (local ports only — the demo
# setup). Set 0.0.0.0 so an edge device on the LAN (e.g. the Jetson) can reach it,
# and start uvicorn with a matching --host. GROUND_PORT defaults to 8001.
# GROUND_HOST=0.0.0.0
# GROUND_PORT=8001

# Optional: base station URL used by edge/live_reporter.py (the live feed,
# single-aircraft by default or all-aircraft with --fleet). Defaults to
# http://127.0.0.1:8001; point it at the base station for
# a LAN test, e.g. http://192.168.1.20:8001. The reporter authenticates with the
# EDGE_<AIRCRAFT>_TOKEN device tokens above and never logs them.
# GROUND_URL=http://127.0.0.1:8001

# Optional: when set on the edge device, each /predict response is also pushed
# to this URL with the device token in the Authorization header.
# GROUND_PUSH_URL=http://127.0.0.1:8001/ingest_report
